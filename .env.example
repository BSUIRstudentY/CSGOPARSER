# Local defaults. Copy to .env if you want to override docker-compose interpolation.
# Do not put production secrets in git.

JWT_SECRET=dev-change-me
PARSER_MODE=demo
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme
POLL_INTERVAL_SECONDS=300
ARB_MIN_STORE_PCT=0
ALLOW_REGISTRATION=true

# DMarket marketplace-api/v2/offers is signed. Both are required for a live DMarket sync.
# Public key is lowercase hex. Secret is the Ed25519 hex key from the trading API page.
# DMARKET_PUBLIC_KEY=
# DMARKET_SECRET_KEY=

# Optional. Skinport, Waxpeer, Market.CSGO, and the partial Steam search do not use these.
# WAXPEER_API_KEY=
# SKINPORT_CLIENT_ID=
# SKINPORT_CLIENT_SECRET=
